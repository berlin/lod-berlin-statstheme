@prefix blnal: <https://berlin.github.io/lod-vocabulary/blnal/> .
@prefix cube: <https://cube.link/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix statstest: <https://berlinonline.github.io/lod-berlin-statstheme/test/> .

statstest:
    a void:Dataset ;
    dct:title "Statstheme Test"@de ;
    dct:title "Statstheme Test"@en ;
    dct:description """Ein Test-Datensatz für das 'statstheme' für Jinja-RDF"""@de ;
    dct:description """A test dataset for the 'statstheme' for Jinja-RDF"""@en ;
    dct:created "2026-07-02"^^xsd:date ;
    # dct:modified "2026-01-27"^^xsd:date ;
    # dct:publisher <uri/of/publisher/organization> ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    foaf:homepage <https://github.com/berlinonline/lod-berlin-statstheme> ;
    void:dataDump <https://raw.githubusercontent.com/berlinonline/lod-berlin-statstheme/main/test/data/stats_data.ttl> ;
    void:feature <http://www.w3.org/ns/formats/Turtle> ;
    void:rootResource statstest:cube ;
    void:exampleResource statstest:obs-1942-02 ;
    void:exampleResource statstest:obs-1967-11 ;
    void:exampleResource statstest:obs-1974-08 ;
    # one or more vocabularies that are used in the actual data (not just here in the void file)
    void:vocabulary cube: , schema: ;
    prov:wasGeneratedBy statstest:triplification ;
    blnal:changelog <https://github.com/berlinonline/lod-berlin-statstheme/main/test/CHANGELOG.md> ;
.

statstest:triplification
    a prov:Activity ;
    rdfs:label "Triplifizierung"@de ;
    rdfs:comment "Die Konvertierung des Quelldatensatzes nach RDF"@de ;
    # prov:used <one/or/more/source/datasets> ;
.

statstest:impressum
    a blnal:ImprintPage ;
    schema:name "Impressum"@de ;
    schema:name "Imprint"@en ;
    schema:description """
Hier sollte der Text des Impressums stehen.

Man kann **Markdown** verwenden.

Auch [Links](https://berlin.de) sollten funktionieren."""@de ;
    schema:about statstest: ;
.

statstest:numberOfSightings
    a owl:DatatypeProperty ;
    rdfs:label "Anzahl Sichtungen"@de ;
    rdfs:label "Number of sightings"@en ;
.