        statstest:obs-1967-03,
        statstest:obs-1967-04,
        statstest:obs-1967-05,
        statstest:obs-1967-06,
        statstest:obs-1967-07,
        statstest:obs-1967-08,
        statstest:obs-1967-09,
        statstest:obs-1967-10,
        statstest:obs-1967-11,
        statstest:obs-1967-12 .

#################################################################
# Observation Set 1974
#################################################################

statstest:obsset-1974
    a cube:ObservationSet ;
