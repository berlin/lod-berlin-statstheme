@prefix cube: <https://cube.link/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix statstest: <https://berlinonline.github.io/lod-berlin-statstheme/test/> .
@prefix demvoc: <https://berlinonline.github.io/lod-berlin-einwohner/vocab/> .
@prefix lor: <https://berlinonline.github.io/lod-berlin-lor/> .

#################################################################
# Cube
#################################################################

statstest:cube
    a cube:Cube ;
    schema:name
        "Berlin District Sighting Statistics"@en ,
        "Statistik der Sichtungen in Berliner Bezirken"@de ;
    schema:description
        "Example statistical dataset containing fictional numbers of sightings for each Berlin district"@en ,
        "Beispieldatensatz mit fiktiven Sichtungszahlen für jeden Berliner Bezirk"@de ;
    cube:observationSet
        statstest:obsset-1942 ,
        statstest:obsset-1967 ,
        statstest:obsset-1974 .

#################################################################
# Observation Set 1942
#################################################################

statstest:obsset-1942
    a cube:ObservationSet ;
    schema:name
        "Sightings in 1942"@en ,
        "Sichtungen im Jahr 1942"@de ;
    schema:description
        "Example observations for all Berlin districts in 1942"@en ,
        "Beispielbeobachtungen für alle Berliner Bezirke im Jahr 1942"@de ;
    cube:observation
        statstest:obs-1942-01,
        statstest:obs-1942-02,
        statstest:obs-1942-03,
        statstest:obs-1942-04,
        statstest:obs-1942-05,
        statstest:obs-1942-06,
        statstest:obs-1942-07,
        statstest:obs-1942-08,
        statstest:obs-1942-09,
        statstest:obs-1942-10,
        statstest:obs-1942-11,
        statstest:obs-1942-12 .

